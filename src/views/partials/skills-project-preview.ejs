<div class="skills-project-preview">
    <% if (project.imageUrl) { %>
        <img class="skills-project-image" src="<%= project.imageUrl %>" alt="<%= project.title %> application preview" loading="lazy" decoding="async" width="800" height="450">
    <% } else { %>
        <div class="skills-project-image-placeholder">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <path d="m21 15-5-5L5 21"/>
            </svg>
            <span>Project image coming soon</span>
        </div>
    <% } %>
</div>
