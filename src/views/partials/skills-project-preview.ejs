            <span class="skills-terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>app.js — express-router</span>
        </div>
        <pre tabindex="0" aria-label="Example Express route"><code><span class="skills-code-comment">// Server-rendered portfolio view</span>
app.<span class="skills-code-keyword">get</span>(<span class="skills-code-string">'/skills'</span>, (req, res) =&gt; {
  res.<span class="skills-code-keyword">render</span>(<span class="skills-code-string">'pages/skillsPage'</span>, {
